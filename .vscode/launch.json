{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tablecraft: Launch app",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "windows": {
        "runtimeExecutable": "${env:LOCALAPPDATA}\\prototyper-tools\\node.exe"
      },
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": ["--host", "127.0.0.1", "--port", "5173", "--strictPort"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "(http://127\\.0\\.0\\.1:5173)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}"
      }
    },
    {
      "name": "Tablecraft: Launch app (installed Node)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": ["--host", "127.0.0.1", "--port", "5173", "--strictPort"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "(http://127\\.0\\.0\\.1:5173)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}"
      }
    }
  ]
}
