{
  "name": "tablecraft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "cli": "tsx scripts/tablecraft.ts",
    "cli:check": "tsc -p tsconfig.cli.json",
    "dev": "vite --host 127.0.0.1 --open",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "db:build": "spacetime build --module-path server",
    "db:generate": "spacetime generate --lang typescript --module-path server --out-dir src/module_bindings -y",
    "db:publish": "spacetime publish tablecraft-studio --module-path server --server http://127.0.0.1:3000",
    "db:publish:maincloud": "spacetime publish tablecraft-xemar5 --module-path server --server maincloud"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "spacetimedb": "2.15.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
